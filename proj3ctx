const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36';
const TIMEOUT = 25000;

// ---------- UI (อ่านจาก ui.html; ถ้าไม่มีใช้หน้า fallback) ----------
let UI;
try {
  UI = fs.readFileSync(path.join(__dirname, 'ui.html'), 'utf8');
