     + '<h1>PROJ3CTX</h1><p style="color:#ff5c6c">ไม่พบไฟล์ ui.html ในโปรเจกต์</p></body></html>';
  console.log('  [warn] ไม่พบ ui.html -> ใช้หน้า fallback');
